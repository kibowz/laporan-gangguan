<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Laporan Gangguan Teknik</title>
  <style>
    body { font-family: Arial, sans-serif; max-width: 500px; margin: 30px auto; padding: 20px; border: 1px solid #ccc; border-radius: 8px; }
    .form-group { margin-bottom: 15px; }
    label { display: block; margin-bottom: 5px; font-weight: bold; }
    input, select, textarea { width: 100%; padding: 8px; box-sizing: border-box; }
    button { background-color: #25D366; color: white; padding: 10px 15px; border: none; border-radius: 4px; cursor: pointer; width: 100%; font-size: 16px; font-weight: bold; }
    button:hover { background-color: #1EBE5D; }
  </style>
</head>
<body>

  <h2>Formulir Laporan Gangguan</h2>
  
  <form id="formLaporan">
    <div class="form-group">
      <label>Nama Pelapor:</label>
      <input type="text" id="nama" required placeholder="Masukkan nama Anda">
    </div>

    <div class="form-group">
      <label>Lokasi / Alamat:</label>
      <input type="text" id="lokasi" required placeholder="Contoh: Gedung A, Lt. 2">
    </div>

    <div class="form-group">
      <label>Kategori Gangguan:</label>
      <select id="kategori" required>
        <option value="">-- Pilih Kategori --</option>
        <option value="Jaringan">Jaringan / Internet</option>
        <option value="Tidak konek & ganti kata sandi</option>
        <option value="Perangkat">Hardware / Perangkat onu</option>
      </select>
    </div>

    <div class="form-group">
      <label>Detail Kendala:</label>
      <textarea id="detail" rows="4" required placeholder="Jelaskan detail kendala..."></textarea>
    </div>

    <button type="button" onclick="kirimKeWA()">Kirim Laporan via WhatsApp</button>
  </form>

  <script>
    // 1. Mapping Daftar Nomor WA Teknisi berdasarkan Kategori
    const daftarTeknisi = {
      "Los Merah Plaju": "6289531125113",   // Ganti dengan No WA Teknisi Jaringan
      "Los Merah kertapati": "6289876543210",    // Ganti dengan No WA Teknisi Listrik
      "Los merah jalan laut": "6283897702480"   // Ganti dengan No WA Teknisi Hardware
      "Gangguan Koneksi Plaju (Ridho)": "62895615484197"   // Ganti dengan No WA Teknisi Hardware
      "Gangguan koneksi Kertapati (Willy)": "62883189260404"   // Ganti dengan No WA Teknisi Hardware
    };

    function kirimKeWA() {
      // 2. Ambil nilai input dari form
      const nama = document.getElementById("nama").value;
      const lokasi = document.getElementById("lokasi").value;
      const kategori = document.getElementById("kategori").value;
      const detail = document.getElementById("detail").value;

      // Validasi input sederhana
      if (!nama || !lokasi || !kategori || !detail) {
        alert("Harap isi semua kolom dalam formulir!");
        return;
      }

      // 3. Tentukan nomor teknisi tujuan
      const noTeknisi = daftarTeknisi[kategori];

      // 4. Susun template pesan
      const pesan = `*LAPORAN GANGGUAN BARU*\n` +
                    `----------------------------------------\n` +
                    `*Pelapor:* ${nama}\n` +
                    `*Kategori:* ${kategori}\n` +
                    `*Lokasi:* ${lokasi}\n` +
                    `*Detail:* ${detail}\n\n` +
                    `Mohon dapat segera ditindaklanjuti. Terima kasih.`;

      // 5. Encode pesan agar aman dibaca URL
      const urlWA = `https://wa.me/${noTeknisi}?text=${encodeURIComponent(pesan)}`;

      // 6. Alihkan pengguna langsung ke WhatsApp
      window.open(urlWA, '_blank');
    }
  </script>

</body>
</html>
